# Altimate FX backend configuration.
#
# Copy to `.env` (same directory you start the server from) and edit. Real environment
# variables take precedence over this file. Never commit a filled-in `.env`.
# Every variable is optional; the defaults below are the safe ones.

# --- Trading mode -----------------------------------------------------------------------
# paper    : local simulated broker, no account or network needed (default)
# practice : OANDA fxTrade Practice (demo) account; needs both OANDA credentials below
# live     : REAL MONEY. Refused unless ALLOW_LIVE_TRADING=true, FXBOT_LIVE_TRADING_CONFIRMED=true
#            and both OANDA credentials are set.
FXBOT_TRADING_MODE=paper

# Live-trading safety switch. Deliberately has no FXBOT_ prefix. Leave false unless you
# intend to trade real money.
ALLOW_LIVE_TRADING=false

# Second, independent confirmation required for live mode.
FXBOT_LIVE_TRADING_CONFIRMED=false

# --- OANDA v20 credentials (secrets) ----------------------------------------------------
# Account id looks like 101-004-1234567-001. The personal access token is generated in
# the OANDA account portal (Manage API Access). Leave empty for paper mode.
FXBOT_OANDA_ACCOUNT_ID=
FXBOT_OANDA_API_TOKEN=

# --- Storage ----------------------------------------------------------------------------
# SQLAlchemy async URL. SQLite by default (path relative to the working directory).
# Postgres needs an async driver added to the project, e.g.
# postgresql+asyncpg://user:password@host:5432/fxbot
FXBOT_DATABASE_URL=sqlite+aiosqlite:///./data/fxbot.db

# --- API server -------------------------------------------------------------------------
# Bind address. Keep 127.0.0.1 on a host machine; the Docker image sets 0.0.0.0 itself.
FXBOT_API_HOST=127.0.0.1
FXBOT_API_PORT=8000
# Browser origins allowed to call the API: comma-separated or a JSON array.
FXBOT_CORS_ORIGINS=http://localhost:5173

# --- Logging ----------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR or CRITICAL.
FXBOT_LOG_LEVEL=INFO
# true = one JSON object per line (production); false = human-readable console output.
FXBOT_LOG_JSON=false
